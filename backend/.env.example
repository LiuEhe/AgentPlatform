# 模型配置，使用 OpenAI 兼容接口
LLM_PROVIDER=openai_compatible
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=180

# RAGFlow 检索配置
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=
RAGFLOW_DATASET_ID=e734ce9ab59511f1b801072adc8623f4

# 服务配置
APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
# 本地 Langfuse；真实凭据只放入后端 .env
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_TIMEOUT_SECONDS=2
LANGFUSE_PROMPTS_ENABLED=false
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_PROMPT_CACHE_TTL_SECONDS=60
# 可选人民币在线文本估算；模型名称精确匹配且三个价格均已填写时生效。
# 单位：元/百万 Token；人民币不写入美元 cost_details，不配置汇率。
# LANGFUSE_COST_MODEL=your-model-name
# LANGFUSE_INPUT_CNY_PER_MILLION=0.8
# LANGFUSE_OUTPUT_CNY_PER_MILLION=2.7
# LANGFUSE_CACHED_INPUT_CNY_PER_MILLION=0.1
MAX_REVIEW_CHARS=50000
MAX_UPLOAD_BYTES=20971520

# 同进程制度审核条款任务共享并发数（正整数）
INSTITUTION_REVIEW_CONCURRENCY=3

# Markdown 转 Word，使用 Python 依赖自带的 Pandoc
DOCUMENT_EXPORT_TIMEOUT_SECONDS=30
DOCUMENT_EXPORT_CONCURRENCY=2
DOCUMENT_EXPORT_MAX_CHARS=200000
DOCUMENT_EXPORT_MAX_BODY_BYTES=1048576
DOCUMENT_EXPORT_MAX_OUTPUT_BYTES=10485760
